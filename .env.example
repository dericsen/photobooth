PORT=3000

# Pilih provider: mock (uji coba, tidak kirim) | fonnte | cloud
WA_PROVIDER=mock
DEFAULT_COUNTRY_CODE=62
WA_CAPTION=Terima kasih sudah mampir ke photobooth kami! 📸✨

# --- Fonnte (https://fonnte.com) ---
FONNTE_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v23.0
# Wajib untuk kirim ke nomor yang belum pernah chat duluan (template dengan header IMAGE)
WA_CLOUD_TEMPLATE_NAME=
WA_CLOUD_TEMPLATE_LANG=id
